#!/bin/sh
# Command-line launcher for Splitterm. Copy it onto your PATH, e.g.:
#   cp scripts/splitterm /usr/local/bin/ (or ~/bin/)
#
#   splitterm                    new window in the current folder
#   splitterm ~/src/project      new window in that folder
#   splitterm --layout oncall    open a saved layout
set -e
urlencode() { python3 -c 'import sys,urllib.parse;print(urllib.parse.quote(sys.argv[1], safe=""))' "$1"; }

case "${1:-}" in
  -l|--layout)
    [ -n "${2:-}" ] || { echo "usage: splitterm --layout NAME" >&2; exit 2; }
    open "splitterm://layout/$(urlencode "$2")" ;;
  -h|--help)
    sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//' ;;
  "")
    open -a Splitterm "$PWD" ;;
  *)
    dir=$(cd "$1" && pwd)
    open -a Splitterm "$dir" ;;
esac
